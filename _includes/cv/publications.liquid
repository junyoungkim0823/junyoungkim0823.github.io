{% comment %}Use the same title / authors / venue hierarchy as the bibliography.{% endcomment %}
<div class="publications cv-publications">
  <ol class="bibliography">
    {% for entry in entries %}
      <li>
        <div class="paper-body">
          <h4 class="title">
            {% if entry.url %}
              <a href="{{ entry.url }}">{{ entry.title | default: entry.name }}</a>
            {% else %}
              {{ entry.title | default: entry.name }}
            {% endif %}
          </h4>
          {% if entry.summary %}
            <div class="author">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
          {% endif %}
          <div class="paper-meta">
            {% if entry.publisher -%}
              <span class="venue-badge">{{ entry.publisher }}</span>
            {%- endif %}
            {% assign pub_date = entry.releaseDate | default: entry.date %}
            {% if pub_date -%}
              <span class="paper-year">{{ pub_date | split: '-' | first }}</span>
            {%- endif %}
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
