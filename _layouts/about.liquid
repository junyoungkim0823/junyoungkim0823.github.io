---
layout: default
---
<div class="post about-page">
  <section class="researcher-hero" aria-labelledby="researcher-name">
    <div class="hero-copy">
      <h1 id="researcher-name" class="post-title">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <div class="hero-intro">{{ page.intro | markdownify }}</div>
      <div class="hero-research">{{ page.research | markdownify }}</div>
      <div class="hero-links">
        {% if site.data.cv.cv.email %}
          <a href="mailto:{{ site.data.cv.cv.email }}"><i class="fa-regular fa-envelope" aria-hidden="true"></i> Email</a>
        {% endif %}
        <a href="{{ '/cv/' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
        <a href="https://di.postech.ac.kr/di/index.do">DI Lab <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {% if page.profile.image %}
      <div class="hero-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_alt = site.first_name | append: ' ' | append: site.last_name %}
        {% include figure.liquid loading="eager" path=profile_image_path class="portrait-image" sizes="(max-width: 640px) 140px, 230px" alt=profile_alt cache_bust=true %}
      </div>
    {% endif %}
  </section>

  <article>{{ content }}</article>
</div>
